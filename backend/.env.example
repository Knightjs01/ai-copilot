ENVIRONMENT=development
DEBUG=true

# Three separate DB roles/connections — see the Phase 1 migration for the full reasoning:
#   copilot      — Postgres bootstrap superuser, migrations only (DDL/role creation).
#   app_runtime  — tenant-scoped runtime queries, no BYPASSRLS, always paired with
#                  SET LOCAL app.current_company_id (app/modules/auth/dependencies.get_tenant_db).
#   app_auth     — pre-authentication lookups only (login/signup by email, token-based flows);
#                  BYPASSRLS because those are inherently cross-tenant (app/db/session.get_db).
# Generate passwords with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Keep these in sync with the passwords embedded in the URLs below — the migration reads the
# _DB_PASSWORD vars directly (to create/update the roles), separately from how the app parses
# the URLs.
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://app_runtime:REPLACE_WITH_APP_DB_PASSWORD@localhost:5432/ai_copilot
AUTH_DATABASE_URL=postgresql+asyncpg://app_auth:REPLACE_WITH_AUTH_DB_PASSWORD@localhost:5432/ai_copilot
MIGRATION_DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/ai_copilot
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Optional, only enforced when ENVIRONMENT=production. Comma-separated list of visitor IPs
# allowed to reach /api/v1/platform-admin/* (Phantom Command) -- every other request to that
# prefix gets a plain 404. Fail-closed: leaving this empty in production blocks everyone,
# including you, until it's set. Must also be set (same value) as PLATFORM_ADMIN_ALLOWED_IPS on
# the frontend's own Railway service -- they're separate containers/env vars even though the
# value is the same.
PLATFORM_ADMIN_ALLOWED_IPS=

# Set to a long random value in every real environment — no default is provided on purpose.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Fernet key used to encrypt MFA secrets at rest — must be different from SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MFA_CHALLENGE_EXPIRE_MINUTES=10

# Set to true once served over HTTPS in production.
COOKIE_SECURE=false

# Local-filesystem resume storage (see app/modules/candidates/storage.py). In docker-compose this
# is backed by a named volume; swap for an S3-backed FileStorage before deploying multi-instance.
STORAGE_DIR=/app/storage
MAX_RESUME_SIZE_MB=10

# Used by app/modules/intelligence (Candidate Intelligence Pack) to call Claude — only ever sent
# the Phase 4 sanitized/redacted text, never a raw resume or PII. Get a key from
# https://console.anthropic.com/ — no default is provided on purpose. Not required to run the
# test suite (tests use a fake LLM client), only for the real API smoke test / real usage.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Real email sending (invite/verification/reset) via Brevo — see app/modules/auth/email.py's
# BrevoEmailSender. Leave both blank for local dev: get_email_sender() falls back to
# ConsoleEmailSender, which just logs the email (and the token inside it) instead of sending.
# BREVO_SENDER_EMAIL must be a verified sender/domain in your Brevo account or sends will fail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Optional, defaults to "Phantom Hire" — the display name recipients see next to the address.
BREVO_SENDER_NAME=

# Optional. Routes the Brevo API call through a static-IP proxy (e.g. QuotaGuardStatic) so
# Brevo's "Authorized IPs" restriction can stay on, pointed at one fixed IP, instead of Railway's
# outbound IP (which isn't static). Form: http://user:pass@host:port. Leave empty to connect
# directly (requires Brevo's IP restriction to be off, or the direct egress IP allowlisted).
OUTBOUND_PROXY_URL=
